# Copy this file to .env and change the values.
# Never commit .env. It can contain your LLM API key.

# --- LLM: any OpenAI-compatible endpoint -------------------------------------
# LM Studio on the same machine (from Docker):  http://host.docker.internal:1234/v1
# Ollama on the same machine (from Docker):     http://host.docker.internal:11434/v1
# llama.cpp llama-server (from Docker):         http://host.docker.internal:8080/v1
# Hosted provider (example):                    https://api.openai.com/v1
LLM_BASE_URL=http://host.docker.internal:1234/v1
# Leave empty for local models. The key stays in the backend.
LLM_API_KEY=
LLM_MODEL=qwen3.5-9b
# Seconds for one LLM request. Small local models can be slow.
LLM_TIMEOUT_SECONDS=180
# auto | json_schema | json_object | none
# auto tries json_schema, then json_object, then plain text with JSON extraction.
LLM_RESPONSE_FORMAT=auto
# Extra attempts when the LLM output fails validation (0-2).
LLM_MAX_RETRIES=2

# --- App ----------------------------------------------------------------------
# 127.0.0.1 = only this machine. 0.0.0.0 = every network interface (your LAN).
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
MAX_INPUT_CHARS=2000
# 1 = log request content and LLM output. Keep 0 in normal use.
DEBUG=0

# --- Data and ETL -------------------------------------------------------------
# Where the cache and the database live on the host.
# A name = a Docker named volume. A path (./data) = a folder on the host.
DATA_VOLUME=macro-data
# Open Food Facts country filter (countries_tags) and preferred name language.
OFF_COUNTRY_TAG=en:spain
OFF_LANG=es
OFF_PARQUET_URL=https://huggingface.co/datasets/openfoodfacts/product-database/resolve/main/food.parquet?download=true
# Empty = the newest Foundation Foods CSV release on the FDC download page.
USDA_FOUNDATION_URL=
USDA_SR_LEGACY_URL=https://fdc.nal.usda.gov/fdc-datasets/FoodData_Central_sr_legacy_food_csv_2018-04.zip
# 1 = download again even when the cached file is current.
ETL_FORCE_DOWNLOAD=0
# Optional DuckDB memory limit for the ETL, for example 4GB.
DUCKDB_MEMORY_LIMIT=
